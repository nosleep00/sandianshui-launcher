<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SandianshuiLauncher.Core\SandianshuiLauncher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 供窗口/标题栏通过 pack:// URI 引用的图标资源（ApplicationIcon 单独负责 exe 图标）。 -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- 版本与产品信息：版本号同时用于窗口底部显示、exe 文件属性与网络请求 User-Agent。 -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <!-- 不把源码提交哈希拼进 InformationalVersion，保证发布版显示的版本号干净（1.0.0）。 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>三点水启动器</Product>
    <Description>一款面向 Windows 的 Minecraft Java 版第三方启动器</Description>
    <Company>三点水启动器贡献者</Company>
    <Copyright>Copyright © 2026 三点水启动器贡献者</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
