<UserControl x:Class="SandianshuiLauncher.Views.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2006"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ViewModels="clr-namespace:SandianshuiLauncher.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ViewModels:DownloadViewModel}">
    <UserControl.Resources>
        <!-- 骨架屏呼吸动画：每行错开一点起播时间，看起来像在逐行加载 -->
        <Storyboard x:Key="SkeletonPulse">
            <DoubleAnimation Storyboard.TargetName="Skel1"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.8"
                             Duration="0:0:1.1"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Skel2"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.8"
                             BeginTime="0:0:0.12"
                             Duration="0:0:1.1"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Skel3"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.8"
                             BeginTime="0:0:0.24"
                             Duration="0:0:1.1"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Skel4"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.8"
                             BeginTime="0:0:0.36"
                             Duration="0:0:1.1"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Skel5"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.8"
                             BeginTime="0:0:0.48"
                             Duration="0:0:1.1"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="Skel6"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.8"
                             BeginTime="0:0:0.6"
                             Duration="0:0:1.1"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource SkeletonPulse}" />
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="28,24" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="PageAction" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="下载游戏"
                           Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding DownloadSourceName}"
                           Style="{StaticResource PageSubtitle}"
                           Margin="0,2,0,0" />
            </StackPanel>
            <ui:Button Grid.Column="1"
                       Content="刷新版本列表"
                       Appearance="Primary"
                       VerticalAlignment="Center"
                       Command="{Binding LoadManifestCommand}" />
        </Grid>

        <!-- 安装模组加载器 -->
        <Border Grid.Row="1"
                Style="{StaticResource CardSurface}"
                Padding="16,12"
                Margin="0,16,0,0"
                DataContext="{Binding Loader}">
            <StackPanel>
                <Grid Margin="0,0,-16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.6*" MinWidth="96" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" MinWidth="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.6*" MinWidth="96" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PageAction" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="模组加载器"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,0,12,0" />
                    <ComboBox Grid.Column="1"
                              Height="32"
                              ToolTip="目标版本"
                              ItemsSource="{Binding TargetVersions}"
                              SelectedItem="{Binding SelectedTargetVersion}" />
                    <TextBlock Grid.Column="2"
                               Text="类型"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0" />
                    <ComboBox Grid.Column="3"
                              Height="32"
                              ItemsSource="{Binding LoaderTypes}"
                              SelectedItem="{Binding SelectedLoaderType}" />
                    <TextBlock Grid.Column="4"
                               Text="版本"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0" />
                    <ComboBox Grid.Column="5"
                              Height="32"
                              Margin="0,0,16,0"
                              ItemsSource="{Binding LoaderVersions}"
                              SelectedItem="{Binding SelectedLoaderVersion}" />
                    <ui:Button Grid.Column="6"
                               Content="安装加载器"
                               Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               Height="32"
                               Padding="16,0"
                               Command="{Binding InstallCommand}"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </Grid>
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="11"
                               Opacity="0.7"
                               TextWrapping="Wrap" />
                    <ProgressBar Height="5"
                                 Margin="0,4,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Progress}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 筛选栏 -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="FilterBox"
                      Height="34"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding FilterType}">
                <ComboBoxItem Content="正式版" Tag="release" />
                <ComboBoxItem Content="快照版" Tag="snapshot" />
                <ComboBoxItem Content="远古版本" Tag="old" />
                <ComboBoxItem Content="全部" Tag="all" />
            </ComboBox>
            <ui:TextBox Grid.Column="1"
                        Margin="12,0,0,0"
                        Height="34"
                        PlaceholderText="搜索版本号，例如 1.21"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- 进度 -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
            <ProgressBar Height="6"
                         Margin="0,6,0,0"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding Progress}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- 版本列表（带骨架屏 / 空状态） -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <ListBox BorderThickness="0"
                     Background="Transparent"
                     ItemsSource="{Binding VisibleVersions}">
                <ListBox.ItemContainerStyle>
                    <!-- 交互效果交给卡片本身（hover 抬升 + 阴影加深），
                         容器只做布局，否则库默认的悬停/选中底色会在卡片外再套一个直角方块。 -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource HoverCardSurface}" Padding="16,10">
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Entry.Id}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TimeDisplay}" FontSize="11" Opacity="0.5" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        CornerRadius="4"
                                        Padding="8,2"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="{Binding TypeDisplay}" FontSize="11" />
                                </Border>
                                <TextBlock Grid.Column="2"
                                           Text="已安装"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Opacity="0.6"
                                           Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button Grid.Column="3"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Content="安装"
                                           Appearance="Primary"
                                           Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           IsEnabled="{Binding IsInstalled, Converter={StaticResource InverseBool}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 骨架屏：首次获取版本清单时占位，避免一大片空白 -->
            <StackPanel Visibility="{Binding ShowSkeleton, Converter={StaticResource BoolToVisibility}}"
                        IsHitTestVisible="False">
                <Border x:Name="Skel1" Style="{StaticResource CardSurface}" Padding="16,12" Margin="0,2">
                    <StackPanel>
                        <Border Height="14" Width="160" CornerRadius="7" HorizontalAlignment="Left"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Border Height="10" Width="100" CornerRadius="5" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border x:Name="Skel2" Style="{StaticResource CardSurface}" Padding="16,12" Margin="0,2">
                    <StackPanel>
                        <Border Height="14" Width="140" CornerRadius="7" HorizontalAlignment="Left"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Border Height="10" Width="90" CornerRadius="5" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border x:Name="Skel3" Style="{StaticResource CardSurface}" Padding="16,12" Margin="0,2">
                    <StackPanel>
                        <Border Height="14" Width="180" CornerRadius="7" HorizontalAlignment="Left"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Border Height="10" Width="110" CornerRadius="5" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border x:Name="Skel4" Style="{StaticResource CardSurface}" Padding="16,12" Margin="0,2">
                    <StackPanel>
                        <Border Height="14" Width="150" CornerRadius="7" HorizontalAlignment="Left"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Border Height="10" Width="95" CornerRadius="5" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border x:Name="Skel5" Style="{StaticResource CardSurface}" Padding="16,12" Margin="0,2">
                    <StackPanel>
                        <Border Height="14" Width="170" CornerRadius="7" HorizontalAlignment="Left"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Border Height="10" Width="105" CornerRadius="5" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border x:Name="Skel6" Style="{StaticResource CardSurface}" Padding="16,12" Margin="0,2">
                    <StackPanel>
                        <Border Height="14" Width="135" CornerRadius="7" HorizontalAlignment="Left"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Border Height="10" Width="85" CornerRadius="5" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 空状态：还没点过「刷新版本列表」 -->
            <StackPanel Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="32"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="⬇"
                               FontSize="26"
                               Opacity="0.75"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="版本列表还没有获取"
                           FontSize="15"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0" />
                <TextBlock Text="点击右上角「刷新版本列表」，即可浏览并安装任意 Minecraft 版本。"
                           FontSize="12"
                           Opacity="0.6"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
                <ui:Button Content="立即获取版本列表"
                           Appearance="Primary"
                           HorizontalAlignment="Center"
                           Padding="18,8"
                           Margin="0,16,0,0"
                           Command="{Binding LoadManifestCommand}" />
            </StackPanel>

            <!-- 筛掉了所有结果 -->
            <StackPanel Visibility="{Binding ShowNoMatch, Converter={StaticResource BoolToVisibility}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="没有匹配的版本"
                           FontSize="15"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="换个筛选条件，或清空搜索关键词再试试。"
                           FontSize="12"
                           Opacity="0.6"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
