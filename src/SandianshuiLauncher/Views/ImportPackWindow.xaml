<ui:FluentWindow x:Class="SandianshuiLauncher.Views.ImportPackWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="导入整合包"
                 Width="560"
                 SizeToContent="Height"
                 MinHeight="420"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitle"
                     Grid.Row="0"
                     Title="导入整合包"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True" />

        <StackPanel Grid.Row="1" Margin="28,12,28,20">
            <TextBlock Text="选择导入方式"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBlock Text="压缩包导入内容到现有版本；文件夹导入完整实例。"
                       FontSize="12"
                       Opacity="0.6"
                       Margin="0,0,0,14" />

            <!-- 压缩包模式 -->
            <Border Style="{StaticResource CardSurface}" Padding="16,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="导入压缩包"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Text=".mrpack / .zip（Modrinth / CurseForge / 备份包）"
                                   FontSize="11"
                                   Opacity="0.55"
                                   Margin="0,2,0,6"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton Content="自动新建实例（推荐）"
                                         GroupName="ImportMode"
                                         IsChecked="{Binding CreateNewInstance}"
                                         ToolTip="按整合包清单自动安装对应游戏版本与加载器，生成独立实例" />
                            <RadioButton Content="导入到现有版本"
                                         GroupName="ImportMode"
                                         Margin="16,0,0,0"
                                         IsChecked="{Binding CreateNewInstance, Converter={StaticResource InverseBool}}"
                                         ToolTip="把模组与配置导入到下面选定的现有版本" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding CreateNewInstance, Converter={StaticResource InverseBool}}">
                            <TextBlock Text="目标版本："
                                       VerticalAlignment="Center"
                                       Opacity="0.7"
                                       FontSize="12" />
                            <ComboBox Width="220"
                                      Height="30"
                                      Margin="8,0,0,0"
                                      ItemsSource="{Binding LocalVersions}"
                                      SelectedItem="{Binding SelectedTargetVersion}"
                                      DisplayMemberPath="Id" />
                        </StackPanel>
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Content="选择文件…"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               Appearance="Primary"
                               Command="{Binding ImportZipCommand}" />
                </Grid>
            </Border>

            <!-- 实例模式 -->
            <Border Style="{StaticResource CardSurface}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="导入整合包实例"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="「解压即玩」文件夹：复制版本目录，合并资源与依赖库，自动检测自带 Java"
                                   FontSize="11"
                                   Opacity="0.55"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Content="选择文件夹…"
                               VerticalAlignment="Center"
                               Margin="14,0,0,0"
                               Command="{Binding ImportFolderCommand}" />
                </Grid>
            </Border>

            <TextBlock Text="{Binding StatusText}"
                       FontSize="11"
                       Opacity="0.6"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
