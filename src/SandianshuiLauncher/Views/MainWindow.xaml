<ui:FluentWindow x:Class="SandianshuiLauncher.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:SandianshuiLauncher.ViewModels"
                 xmlns:views="clr-namespace:SandianshuiLauncher.Views"
                 xmlns:core="clr-namespace:SandianshuiLauncher.Core;assembly=SandianshuiLauncher.Core"
                 Title="三点水启动器"
                 Width="1060"
                 Height="700"
                 MinWidth="900"
                 MinHeight="580"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 AllowDrop="True"
                 DragOver="Window_DragOver"
                 DragLeave="Window_DragLeave"
                 Drop="Window_Drop"
                 Icon="pack://application:,,,/assets/app.ico"
                 Background="{DynamicResource ApplicationBackgroundColorBrush}">
    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:LaunchViewModel}">
            <views:LaunchPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DownloadViewModel}">
            <views:DownloadPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VersionsViewModel}">
            <views:VersionsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModsViewModel}">
            <views:ModsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage />
        </DataTemplate>

        <!-- 页面切换动画：整页淡入 + 轻微上移，避免切换时内容硬切闪一下 -->
        <Storyboard x:Key="PageTransition">
            <DoubleAnimation Storyboard.TargetName="PageHost"
                             Storyboard.TargetProperty="Opacity"
                             From="0.35"
                             To="1"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PageHost"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="12"
                             To="0"
                             Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏：可拖动移动窗口，右上角提供最小化、最大化/还原、关闭按钮 -->
        <ui:TitleBar Grid.Row="0"
                     Title="三点水启动器"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧边导航栏 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="20,18,20,12">
                        <TextBlock Text="三点水启动器"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Sandianshui Launcher"
                                   FontSize="11"
                                   Opacity="0.55"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             x:Name="NavList"
                             Margin="10,6"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="NavList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <!-- 分层绘制：悬停层、选中层各自动画透明度，内容再做一个轻微右移入场 -->
                                            <Grid x:Name="Root"
                                                  Background="Transparent"
                                                  SnapsToDevicePixels="True">
                                                <Border x:Name="HoverLayer"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="8"
                                                        Opacity="0" />
                                                <Border x:Name="SelectLayer"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="8"
                                                        Opacity="0" />
                                                <ContentPresenter x:Name="Presenter" Margin="12,11">
                                                    <ContentPresenter.RenderTransform>
                                                        <TranslateTransform x:Name="ContentSlide" X="0" />
                                                    </ContentPresenter.RenderTransform>
                                                </ContentPresenter>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="1"
                                                                                 Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="0"
                                                                                 Duration="0:0:0.2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <!-- 从 0.35 起淡入而不是从 0 起：白色文字已经就位，避免中途看不清 -->
                                                                <DoubleAnimation Storyboard.TargetName="SelectLayer"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 From="0.35"
                                                                                 To="1"
                                                                                 Duration="0:0:0.16">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="ContentSlide"
                                                                                 Storyboard.TargetProperty="X"
                                                                                 From="-10"
                                                                                 To="0"
                                                                                 Duration="0:0:0.24">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="SelectLayer"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 To="0"
                                                                                 Duration="0:0:0.15" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Tag="launch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="启动游戏" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="download">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬇" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="下载游戏" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="mods">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧩" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="模组" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="versions">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▦" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="版本管理" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="设置" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="20,10">
                        <TextBlock x:Name="VersionText"
                                   Text="{Binding Source={x:Static core:LauncherInfo.DisplayVersion}, StringFormat={}{0} · 开源版}"
                                   FontSize="11"
                                   Opacity="0.45" />
                        <TextBlock Text="Minecraft Java Edition"
                                   FontSize="10"
                                   Opacity="0.35"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <ContentControl x:Name="PageHost"
                            Grid.Column="1"
                            Content="{Binding CurrentPage}">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="PageSlide" Y="0" />
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- 拖拽提示蒙层：拖入文件时显示 -->
        <Border x:Name="DropOverlay"
                Grid.RowSpan="2"
                Panel.ZIndex="100"
                Background="#99000000"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Width="72"
                        Height="72"
                        CornerRadius="36"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="⬇"
                               FontSize="30"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="松开鼠标以安装"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0" />
                <TextBlock Text="支持 .jar 模组 与 .mrpack / .zip 整合包"
                           FontSize="13"
                           Foreground="#DDDDDDDD"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
