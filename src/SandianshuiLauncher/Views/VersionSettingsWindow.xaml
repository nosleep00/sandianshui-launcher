<ui:FluentWindow x:Class="SandianshuiLauncher.Views.VersionSettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="版本设置"
                 Width="480"
                 SizeToContent="Height"
                 MaxHeight="640"
                 MinHeight="380"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitle"
                     Grid.Row="0"
                     Title="版本设置"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True" />

        <StackPanel Grid.Row="1" Margin="28,12,28,20">
            <TextBlock Text="版本独立设置"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBlock x:Name="HintText"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Opacity="0.6"
                       Margin="0,0,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="最小内存（MB）" FontSize="12" Opacity="0.7" />
                    <TextBox x:Name="MinMemoryBox" Height="32" Margin="0,4,0,8" />
                    <TextBlock Text="窗口宽度（0 或留空 = 默认）" FontSize="12" Opacity="0.7" />
                    <TextBox x:Name="WidthBox" Height="32" Margin="0,4,0,8" />
                    <TextBlock Text="Java 路径（java.exe，留空 = 自动）" FontSize="12" Opacity="0.7" />
                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="JavaPathBox" Height="32" />
                        <ui:Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="BrowseJava_Click" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="最大内存（MB）" FontSize="12" Opacity="0.7" />
                    <TextBox x:Name="MaxMemoryBox" Height="32" Margin="0,4,0,8" />
                    <TextBlock Text="窗口高度（0 或留空 = 默认）" FontSize="12" Opacity="0.7" />
                    <TextBox x:Name="HeightBox" Height="32" Margin="0,4,0,8" />
                    <ui:ToggleSwitch Content="全屏启动"
                                     x:Name="FullscreenSwitch"
                                     Margin="0,6,0,8" />
                </StackPanel>
            </Grid>

            <TextBlock Text="额外 JVM 参数" FontSize="12" Opacity="0.7" />
            <TextBox x:Name="JvmArgsBox" Height="32" Margin="0,4,0,14" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="1" Content="恢复全局设置" Margin="0,0,10,0" Click="Reset_Click" />
                <ui:Button Grid.Column="2" Content="取消" Width="90" Margin="0,0,10,0" Click="Cancel_Click" />
                <ui:Button Grid.Column="3" Content="保存" Width="90" Appearance="Primary" Click="Save_Click" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
