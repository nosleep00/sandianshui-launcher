<ui:FluentWindow x:Class="SandianshuiLauncher.Views.AddAccountWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="添加账号"
                 Width="460"
                 SizeToContent="Height"
                 MinHeight="360"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 固定大小对话框：只保留关闭按钮 -->
        <ui:TitleBar Grid.Row="0"
                     x:Name="WindowTitleBar"
                     Title="添加账号"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True" />

        <StackPanel Grid.Row="1" Margin="28,12,28,20">
            <TextBlock x:Name="HeadingText"
                       Text="添加账号"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <TextBlock Text="离线模式无需联网，仅能单人游戏；外置登录可连接皮肤站（如 LittleSkin）。"
                       TextWrapping="Wrap"
                       Opacity="0.65"
                       Margin="0,0,0,14" />

            <!-- 离线用户名（外置登录时自动填入皮肤站角色名）；仿 PCL2 允许留空 -->
            <TextBlock Text="用户名（离线）" FontSize="12" Opacity="0.7" />
            <TextBox x:Name="UsernameBox"
                     MaxLength="16"
                     Height="34"
                     Margin="0,4,0,6"
                     KeyDown="UsernameBox_KeyDown" />
            <TextBlock x:Name="UsernameHint"
                       Text="可以留空先添加，但留空时不能启动游戏；3–16 位字母、数字或下划线。"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Opacity="0.6"
                       Margin="0,0,0,10" />

            <ui:ToggleSwitch x:Name="AuthlibSwitch"
                             Content="使用外置登录（皮肤站，如 LittleSkin）"
                             Margin="0,0,0,10"
                             Checked="AuthlibSwitch_Changed"
                             Unchecked="AuthlibSwitch_Changed" />

            <StackPanel x:Name="AuthlibPanel" Visibility="Collapsed">
                <TextBlock Text="认证服务器地址（Yggdrasil API 根地址）" FontSize="12" Opacity="0.7" />
                <TextBox x:Name="ServerBox"
                         Height="34"
                         Margin="0,4,0,10"
                         Text="https://littleskin.cn/api/yggdrasil" />
                <TextBlock Text="皮肤站邮箱" FontSize="12" Opacity="0.7" />
                <TextBox x:Name="EmailBox"
                         Height="34"
                         Margin="0,4,0,10" />
                <TextBlock Text="皮肤站密码" FontSize="12" Opacity="0.7" />
                <PasswordBox x:Name="PasswordBox"
                             Height="34"
                             Margin="0,4,0,10" />
            </StackPanel>

            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Opacity="0.7"
                       Margin="0,0,0,8" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="1"
                           Content="取消"
                           Width="90"
                           Margin="0,0,10,0"
                           Click="Cancel_Click" />
                <ui:Button x:Name="OkButton"
                           Grid.Column="2"
                           Content="添加"
                           Width="90"
                           Appearance="Primary"
                           Click="Ok_Click" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
