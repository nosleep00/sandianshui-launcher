<UserControl x:Class="SandianshuiLauncher.Views.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ViewModels="clr-namespace:SandianshuiLauncher.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=ViewModels:ModsViewModel}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="模组"
                   Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="0"
                   Text="数据来源 Modrinth · MCIM 国内镜像加速"
                   Style="{StaticResource PageSubtitle}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" />

        <!-- 筛选栏 -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0"
                      Height="34"
                      Margin="0,0,8,0"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding SelectedResourceType}"
                      ToolTip="选择要搜索安装的资源类型">
                <ComboBoxItem Content="模组" Tag="mod" />
                <ComboBoxItem Content="资源包" Tag="resourcepack" />
                <ComboBoxItem Content="光影包" Tag="shader" />
            </ComboBox>
            <ComboBox Grid.Column="1"
                      Height="34"
                      Margin="0,0,8,0"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding SelectedPlatform}"
                      ToolTip="选择模组平台（CurseForge 需在设置中填写 API Key）">
                <ComboBoxItem Content="Modrinth" Tag="modrinth" />
                <ComboBoxItem Content="CurseForge" Tag="curseforge" />
            </ComboBox>
            <ComboBox Grid.Column="2"
                      Height="34"
                      Margin="0,0,8,0"
                      ItemsSource="{Binding LocalVersions}"
                      SelectedItem="{Binding SelectedVersion}"
                      DisplayMemberPath="Id"
                      ToolTip="选择要安装模组的游戏版本" />
            <ComboBox Grid.Column="3"
                      Height="34"
                      Margin="0,0,8,0"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding SelectedLoader}"
                      ToolTip="按模组加载器筛选；若搜不到可切换为“任意加载器”">
                <ComboBoxItem Content="任意加载器" Tag="" />
                <ComboBoxItem Content="Fabric" Tag="fabric" />
                <ComboBoxItem Content="Forge" Tag="forge" />
                <ComboBoxItem Content="NeoForge" Tag="neoforge" />
                <ComboBoxItem Content="Quilt" Tag="quilt" />
            </ComboBox>
            <ComboBox Grid.Column="4"
                      Height="34"
                      Margin="0,0,8,0"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding SelectedSort}"
                      ToolTip="选择结果排序方式；找“下载量最多”的模组请选择“下载量”">
                <ComboBoxItem Content="相关性" Tag="relevance" />
                <ComboBoxItem Content="下载量" Tag="downloads" />
                <ComboBoxItem Content="关注量" Tag="follows" />
                <ComboBoxItem Content="最新发布" Tag="newest" />
                <ComboBoxItem Content="最近更新" Tag="updated" />
            </ComboBox>
            <ui:TextBox Grid.Column="5"
                        Height="34"
                        Margin="0,0,8,0"
                        VerticalContentAlignment="Center"
                        PlaceholderText="搜索模组，支持中文（如 小地图、优化）"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="输入名称或关键词，支持中文（如 小地图、光影、优化）；留空浏览热门模组" />
            <ui:Button Grid.Column="6"
                       Content="搜索"
                       Appearance="Primary"
                       Height="34"
                       Command="{Binding SearchCommand}" />
        </Grid>

        <!-- 进度 / 状态 -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="12"
                       Opacity="0.7"
                       TextWrapping="Wrap" />
            <ProgressBar Height="6"
                         Margin="0,6,0,0"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding Progress}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- 主体：左搜索结果，右已安装 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- 搜索结果 -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="搜索结果"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="2,0,0,8" />
                <ListBox Grid.Row="1"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding Results}">
                    <ListBox.ItemContainerStyle>
                        <!-- 交互效果交给卡片本身（hover 抬升 + 阴影加深），容器只负责布局。 -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HoverCardSurface}" Padding="12,10">
                                <Border.RenderTransform>
                                    <TranslateTransform />
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 模组图标：加载失败时保留占位背景 -->
                                    <Border Grid.Column="0"
                                            Width="52"
                                            Height="52"
                                            CornerRadius="8"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            ClipToBounds="True"
                                            VerticalAlignment="Top">
                                        <Image Source="{Binding IconUrl}"
                                               Width="52"
                                               Height="52"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DisplaySubtitle}"
                                                       FontSize="11"
                                                       Opacity="0.5"
                                                       Margin="8,2,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding DisplaySubtitle, Converter={StaticResource NullToCollapsed}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding DownloadsDisplay, StringFormat='下载量 {0}'}"
                                                   FontSize="11"
                                                   Opacity="0.5"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12"
                                                   Opacity="0.65"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,8,0" />
                                        <TextBlock Text="{Binding LoadersDisplay, StringFormat='加载器：{0}'}"
                                                   FontSize="11"
                                                   Opacity="0.5"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Content="安装"
                                               Appearance="Primary"
                                               Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 已安装模组 -->
            <Border Grid.Column="1" Style="{StaticResource CardSurface}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="已安装模组"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Content="导入整合包"
                                       Margin="0,0,6,0"
                                       Command="{Binding OpenImportPackCommand}" />
                            <ui:Button Content="打开目录"
                                       Command="{Binding OpenModsFolderCommand}" />
                        </StackPanel>
                    </Grid>
                    <!-- 批量运维工具栏 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button Content="全选"
                                   Width="52"
                                   Padding="0"
                                   Margin="0,0,6,0"
                                   Command="{Binding ToggleSelectAllCommand}" />
                        <ui:Button Content="启用"
                                   Width="52"
                                   Padding="0"
                                   Margin="0,0,6,0"
                                   Command="{Binding BatchEnableCommand}" />
                        <ui:Button Content="禁用"
                                   Width="52"
                                   Padding="0"
                                   Margin="0,0,6,0"
                                   Command="{Binding BatchDisableCommand}" />
                        <ui:Button Content="删除"
                                   Width="52"
                                   Padding="0"
                                   Command="{Binding BatchDeleteCommand}" />
                    </StackPanel>

                    <!-- 分组工具栏 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <ComboBox Width="96"
                                  Height="38"
                                  Margin="0,0,4,0"
                                  ItemsSource="{Binding GroupNames}"
                                  SelectedItem="{Binding SelectedGroupName}"
                                  ToolTip="选择已保存的模组组合方案" />
                        <ui:Button Content="应用"
                                   Width="48"
                                   Height="38"
                                   Padding="0"
                                   Margin="0,0,4,0"
                                   Command="{Binding ApplyGroupCommand}" />
                        <ui:Button Content="保存"
                                   Width="48"
                                   Height="38"
                                   Padding="0"
                                   Margin="0,0,4,0"
                                   Command="{Binding SaveGroupCommand}" />
                        <ui:Button Content="删组"
                                   Width="48"
                                   Height="38"
                                   Padding="0"
                                   Command="{Binding DeleteGroupCommand}" />
                    </StackPanel>

                    <TextBlock Grid.Row="3"
                               Text="{Binding InstalledMods.Count, StringFormat='当前版本 mods 目录共 {0} 个 jar（勾选可批量操作）'}"
                               FontSize="11"
                               Opacity="0.55"
                               Margin="0,8,0,8"
                               TextWrapping="Wrap" />
                    <Grid Grid.Row="4">
                        <ListBox BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemsSource="{Binding InstalledMods}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6"
                                            Padding="10,7"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      ToolTip="勾选以批量操作" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                                <TextBlock FontSize="10"
                                                           Opacity="0.5"
                                                           Margin="0,2,0,0">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} · {1}">
                                                            <Binding Path="SizeDisplay" />
                                                            <Binding Path="IsEnabled" Converter="{StaticResource EnabledToStatus}" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <ui:Button HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"
                                                           Content="{Binding IsEnabled, Converter={StaticResource EnabledToAction}}"
                                                           Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Content="删除"
                                                           Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="尚未安装模组"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,24"
                                   FontSize="12"
                                   Opacity="0.4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InstalledMods.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
