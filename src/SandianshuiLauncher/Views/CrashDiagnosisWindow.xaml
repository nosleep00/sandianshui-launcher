<ui:FluentWindow x:Class="SandianshuiLauncher.Views.CrashDiagnosisWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="崩溃诊断"
                 Width="560"
                 Height="640"
                 MinWidth="480"
                 MinHeight="480"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏：保留最小化/最大化/关闭，允许调整窗口大小 -->
        <ui:TitleBar Grid.Row="0" Title="崩溃诊断" />

        <!-- 诊断内容：内容较多时可滚动 -->
        <ScrollViewer Grid.Row="1"
                      Margin="28,8,28,12"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 原因标题 -->
                <TextBlock Text="{Binding Title}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap" />

                <!-- 元信息：严重级别 + 相关模组 -->
                <WrapPanel Margin="0,10,0,0">
                    <Border CornerRadius="6"
                            Padding="10,4"
                            Background="{DynamicResource ControlElevationBorderBrush}">
                        <TextBlock FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="严重级别：未知" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Info">
                                            <Setter Property="Text" Value="严重级别：提示" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                            <Setter Property="Text" Value="严重级别：警告" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                            <Setter Property="Text" Value="严重级别：错误" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Fatal">
                                            <Setter Property="Text" Value="严重级别：致命" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Border CornerRadius="6"
                            Padding="10,4"
                            Margin="8,0,0,0"
                            Background="{DynamicResource ControlElevationBorderBrush}"
                            Visibility="{Binding RelatedMod, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock FontSize="12"
                                   Text="{Binding RelatedMod, StringFormat=相关模组：{0}}" />
                    </Border>
                </WrapPanel>

                <!-- 问题详情 -->
                <TextBlock Text="问题详情"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,18,0,6"
                           Opacity="0.85" />
                <TextBlock Text="{Binding Detail}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           LineHeight="20" />

                <!-- 修复建议 -->
                <TextBlock Text="修复建议"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,18,0,6"
                           Opacity="0.85" />
                <TextBlock Text="{Binding SuggestionsText}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           LineHeight="20" />

                <!-- 证据行 -->
                <TextBlock Text="相关日志"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,18,0,6"
                           Opacity="0.85" />
                <Border CornerRadius="8"
                        Padding="12"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TextBlock Text="{Binding MatchedLine}"
                               FontFamily="Consolas,Microsoft YaHei UI"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Opacity="0.8" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作 -->
        <Grid Grid.Row="2" Margin="28,0,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0"
                       Content="打开日志目录"
                       Height="38"
                       Click="OpenLogs_Click" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button x:Name="FixButton"
                           Content="一键修复"
                           Height="38"
                           Margin="0,0,12,0"
                           Click="Fix_Click"
                           ToolTip="自动执行修复（如自动安装缺失模组、调整内存、切换 Java）" />
                <ui:Button Content="我知道了"
                           Height="38"
                           Appearance="Primary"
                           Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
