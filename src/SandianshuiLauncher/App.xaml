<Application x:Class="SandianshuiLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:SandianshuiLauncher.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBoolConverter x:Key="InverseBool" />
            <converters:EmptyStringToCollapsedConverter x:Key="NullToCollapsed" />
            <converters:EnabledToStatusConverter x:Key="EnabledToStatus" />
            <converters:EnabledToActionConverter x:Key="EnabledToAction" />

            <!-- 卡片容器样式：WPF-UI 4.x 的 CardControl 是 图标/标题/内容 三列布局，
                 不适合作为自由布局容器；这里用原生 Border 复刻其外观。 -->
            <Style x:Key="CardSurface" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <!-- 统一的 1 级阴影：让卡片从页面底色上"浮"起来，而不是贴在底板上。 -->
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="16"
                                          ShadowDepth="2"
                                          Direction="270"
                                          Opacity="0.07"
                                          Color="#FF000000" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 可点击的卡片：hover 时微微抬升 2px，阴影加深一层。
                 注意：使用本样式时必须给 Border 内联声明
                 <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>，
                 动画才能作用在独一无二的变换实例上（样式里声明的变换会被冻结，无法动画）。
                 tests/SandianshuiLauncher.App.Tests/CardStyleTests.cs 会守住这条约定。 -->
            <Style x:Key="HoverCardSurface" TargetType="Border" BasedOn="{StaticResource CardSurface}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="26"
                                                  ShadowDepth="6"
                                                  Direction="270"
                                                  Opacity="0.16"
                                                  Color="#FF000000" />
                            </Setter.Value>
                        </Setter>
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     To="-2"
                                                     Duration="0:0:0.14">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     To="0"
                                                     Duration="0:0:0.18">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 统一按钮圆角在 App.OnStartup 里完成（App.xaml.cs 的 ApplyGlobalButtonCornerRadius）：
                 隐式样式无法 BasedOn 库里的同名隐式样式（会解析成自己，丢掉模板变成裸 WPF 按钮）。 -->

            <!-- 页面级标题 / 副标题统一风格（各页面共用，保证观感一致）。 -->
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="PageSubtitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.55" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
